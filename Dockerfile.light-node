FROM rust:1-bookworm AS builder

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN curl --fail --location --silent --show-error \
        "https://github.com/N-010/qubic-random-client-qubic-light-node/archive/aeedf174f82482a2a839b75238181a6f32468ed6.tar.gz" \
        --output /tmp/light-node.tar.gz \
    && tar --extract --gzip --file /tmp/light-node.tar.gz --strip-components=1 \
    && rm /tmp/light-node.tar.gz \
    && cargo build --release --locked

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/QubicLightNode /usr/local/bin/QubicLightNode

USER 65532:65532
WORKDIR /app

EXPOSE 21841/tcp 50051/tcp

ENTRYPOINT ["/usr/local/bin/QubicLightNode"]
